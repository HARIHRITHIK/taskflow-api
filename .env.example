# TaskFlow API Configuration
PROJECT_NAME="TaskFlow API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # Options: 'development', 'staging', 'production'

# Security Configuration (MUST be changed in Production)
SECRET_KEY="generate-a-secure-random-32-character-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL
# Development / Local:
DATABASE_URL="sqlite:///./taskflow.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://taskflow_user:taskflow_pass@localhost:5432/taskflow_db"

# Allowed CORS Origins (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501"

# Auth Rate Limiting Rule
AUTH_RATE_LIMIT="10/minute"
