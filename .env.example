# TaskFlow API Configuration
PROJECT_NAME="TaskFlow API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security (Change in Production)
SECRET_KEY="your-super-secret-jwt-key-minimum-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (Defaults to SQLite for instant local execution, PostgreSQL in Production)
DATABASE_URL="sqlite:///./taskflow.db"
# DATABASE_URL="postgresql://taskflow_user:taskflow_pass@localhost:5432/taskflow_db"

# Rate Limiting
AUTH_RATE_LIMIT="10/minute"
