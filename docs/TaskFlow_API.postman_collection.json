{
  "info": {
    "_postman_id": "taskflow-api-collection-v1",
    "name": "TaskFlow API",
    "description": "Production-inspired REST API Postman Collection for TaskFlow API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System & Probes",
      "item": [
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ready", "host": ["{{baseUrl}}"], "path": ["ready"] }
          }
        },
        {
          "name": "Version Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/version", "host": ["{{baseUrl}}"], "path": ["version"] }
          }
        },
        {
          "name": "Operational Metrics Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/system/stats", "host": ["{{baseUrl}}"], "path": ["api", "v1", "system", "stats"] }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"email\": \"demo@taskflow.dev\",\n  \"password\": \"TaskFlowDemo123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login (Get JWT Bearer Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "demo@taskflow.dev", "type": "text" },
                { "key": "password", "value": "TaskFlowDemo123!", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Tasks CRUD & Search",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Audit Service Layer Performance\",\n  \"description\": \"Review repository queries and response serialization speed.\",\n  \"priority\": \"HIGH\",\n  \"due_date\": \"2026-08-30T18:00:00Z\",\n  \"tags\": \"backend,performance\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/tasks/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tasks", ""] }
          }
        },
        {
          "name": "List Tasks (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/?page=1&page_size=10&sort_by=created_at&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" },
                { "key": "sort_by", "value": "created_at" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get Task By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/tasks/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tasks", "1"] }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_completed\": true,\n  \"priority\": \"URGENT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/tasks/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tasks", "1"] }
          }
        },
        {
          "name": "Soft Delete Task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/tasks/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "tasks", "1"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "bearerToken", "value": "YOUR_JWT_TOKEN_HERE" }
  ]
}
